# ---- Core Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---- Database ----
# Local dev (Docker Postgres from docker-compose.yml, host port 5433):
DATABASE_URL=postgres://notif:notif@localhost:5433/notifications
# On Render this is provided automatically by the managed Postgres add-on.
DB_SSL_REQUIRE=False

# ---- CORS (the deployed frontend origin) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex to allow Vercel preview deploys, e.g. ^https://.*\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# ---- Scheduled trigger runner ----
# Shared secret required in the X-Scheduled-Secret header to run scheduled triggers.
SCHEDULED_RUN_SECRET=change-me-scheduled-secret

# ---- WhatsApp Cloud API (sandbox) ----
# From Meta for Developers > your app > WhatsApp > API Setup.
# The temporary token expires ~24h; regenerate it there when test sends start failing.
WHATSAPP_ACCESS_TOKEN=your_test_token
PHONE_NUMBER_ID=your_test_phone_number_id
WHATSAPP_API_VERSION=v21.0

# ---- Email (Resend) ----
# From resend.com > API Keys. FROM must be a verified sender/domain.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=you@yourdomain.com

# ---- Web Push (OneSignal) ----
# From onesignal.com > your app > Settings > Keys & IDs.
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
